---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090c" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url('/')}>{site.name}</a>
        <nav aria-label="Main">
          <a href={url('/#projects')}>Work</a>
          <a href={url('/#about')}>About</a>
          <a href={url('/#contact')}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="site-footer__links">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a>
          <a href={site.github} rel="noopener" target="_blank">GitHub</a>
          {site.cv && <a href={site.cv} download={site.cvName}>CV</a>}
        </span>
      </div>
    </footer>

    <script>
      // The header floats transparently over the hero, then turns solid while scrolling.
      const header = document.querySelector('.site-header')!;
      const update = () => header.classList.toggle('is-solid', scrollY > 80);
      addEventListener('scroll', update, { passive: true });
      update();
    </script>
  </body>
</html>
